# Porta HTTP da API (o app mobile procura a API na porta 3001 por padrão)
PORT=3001

# String de conexão do MongoDB.
# Local (sem Docker): mongodb://localhost:27017/blog
# Via docker-compose:  mongodb://mongo:27017/blog
MONGODB_URI=mongodb://localhost:27017/blog

# Segredo usado para assinar os tokens JWT. Troque em produção.
JWT_SECRET=troque-esta-chave-em-producao

# Origem liberada no CORS (* em desenvolvimento)
CORS_ORIGIN=*

# Primeiro professor, criado automaticamente se não houver nenhum no banco.
DEFAULT_TEACHER_NAME=Professor Administrador
DEFAULT_TEACHER_EMAIL=professor@escola.com
DEFAULT_TEACHER_PASSWORD=professor123

# Código que um professor informa para se cadastrar pela tela do app.
# Deixe vazio para permitir cadastro pela tela apenas de alunos.
TEACHER_SIGNUP_CODE=professor2026

# true = cria também um aluno e posts de demonstração na subida do servidor
SEED_DEMO_DATA=false
